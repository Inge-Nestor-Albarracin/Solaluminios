{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/api",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/api",
        "start"
      ],
      "env": {
        "PORT": "3101",
        "CORS_ORIGIN": "http://localhost:5174"
      },
      "port": 3101
    },
    {
      "name": "api-test",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/api",
        "start:test-db"
      ],
      "env": {
        "PORT": "3101",
        "CORS_ORIGIN": "http://localhost:5174"
      },
      "port": 3101
    },
    {
      "name": "api-test-pwa",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/api",
        "exec",
        "node",
        "--env-file-if-exists=.env.push-test",
        "scripts/start-test-api.mjs"
      ],
      "env": {
        "PORT": "3101",
        "CORS_ORIGIN": "http://localhost:4173",
        "READER_CAPTURE_ENABLED": "true"
      },
      "port": 3101
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "exec",
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "dev",
        "--port",
        "5174"
      ],
      "env": {
        "VITE_API_URL": "http://localhost:3101"
      },
      "port": 5174
    }
  ]
}
