generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryLocationType {
  WAREHOUSE
  RETAIL_STORE
  // Accessories warehouse: only accessory baskets (no aisles nor racks), run
  // by the ACCESSORIES role (docs/accesorios-fase-1.md).
  ACCESSORY_WAREHOUSE
}

enum ArrivalDatePrecision {
  EXACT
  MONTH
  UNKNOWN
}

enum InventoryMovementType {
  INITIAL_STOCK
  ENTRY
  EXIT
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  // The bundle is opened: its profiles become loose in the same place. Not an
  // exit: quantity before = after = quantity.
  OPENING
  // Profiles a customer gave back (sales return), into the bundle they left.
  RETURN
}

enum UserRole {
  ADMIN
  WAREHOUSE
  SALES
  READ_ONLY
  // Supplier-side operator in China: only pre-registers bundles of the
  // configured Chinese supplier (explicit routes only, see RolesGuard).
  CHINA_OPERATOR
  // Billing: receives the orders that need an invoice, downloads their PDF
  // and records the invoice number made in the billing software. No
  // inventory, costs nor quotes.
  BILLING
  // Accessories warehouse (docs/accesorios-fase-1.md): baskets with one chip
  // each, entries, counter sales and accessory dispatches, built in stages.
  // Explicit routes only (see RolesGuard); no profiles, costs nor users.
  ACCESSORIES
}

// Origin of the material (independent from the supplier's address). Bundles
// without a lot have an UNKNOWN origin: they stay in stock but cannot fulfil
// an order line until an administrator classifies them.
enum MaterialOrigin {
  CHINA
  NATIONAL
}

// LOCATIONS: existing physical table/column names are preserved with mappings.

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLocations InventoryLocation[]

  @@map("branches")
}

model InventoryLocation {
  id        String                @id @default(cuid())
  code      String
  name      String
  type      InventoryLocationType @default(WAREHOUSE)
  active    Boolean               @default(true)
  branchId  String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  branch               Branch              @relation(fields: [branchId], references: [id])
  aisles               Aisle[]
  bundles              Bundle[]
  defaultUsers         User[]
  outgoingMovements    InventoryMovement[] @relation("MovementSourceLocation")
  incomingMovements    InventoryMovement[] @relation("MovementDestinationLocation")
  salesOrders          SalesOrder[]
  dispatches           Dispatch[]
  readerDevices        ReaderDevice[]
  materialRequestsFrom MaterialRequest[]   @relation("MaterialRequestSource")
  materialRequestsTo   MaterialRequest[]   @relation("MaterialRequestDestination")
  accessoryVouchers    AccessoryVoucher[]
  salesReturns         SalesReturn[]

  @@unique([branchId, code], map: "warehouses_branchId_code_key")
  @@map("warehouses")
}

model Aisle {
  id                  String   @id @default(cuid())
  number              Int
  floorNumber         Int?
  active              Boolean  @default(true)
  inventoryLocationId String   @map("warehouseId")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  inventoryLocation InventoryLocation @relation(fields: [inventoryLocationId], references: [id])
  racks             Rack[]

  @@unique([inventoryLocationId, number], map: "aisles_warehouseId_number_key")
  @@map("aisles")
}

model Rack {
  id        String   @id @default(cuid())
  number    Int
  active    Boolean  @default(true)
  aisleId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aisle             Aisle               @relation(fields: [aisleId], references: [id])
  bundles           Bundle[]
  outgoingMovements InventoryMovement[] @relation("MovementSourceRack")
  incomingMovements InventoryMovement[] @relation("MovementDestinationRack")

  @@unique([aisleId, number])
  @@map("racks")
}

// CATALOG: current Reference/Finish fields are retained for API compatibility.

// What a family groups. PROFILE: aluminium profiles (colour, counted in
// profiles, bundles with RFID). ACCESSORY: hardware and gaskets, catalog only
// for now (no colour, sold by unit / metre / roll): operations refuse them.
enum ProductKind {
  PROFILE
  ACCESSORY
}

model ProductFamily {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  kind      ProductKind @default(PROFILE)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  references Reference[]

  @@map("product_families")
}

model Reference {
  id           String   @id @default(cuid())
  code         String   @unique
  description  String?
  active       Boolean  @default(true)
  familyId     String?
  // Other families where operators also know this reference (catalog note,
  // shown as a hint only). The reference belongs to `familyId` alone: no
  // filter, total or report uses this text.
  familyHint   String?
  // Accessories: the code above is internal (invented, unique); people see
  // the supplier's / maker's code (may repeat, e.g. per metre and per roll;
  // leading zeros kept) or, without one, only the description.
  supplierCode String?
  // Supplier or brand as the catalog names it (YALE, PACKLINE…).
  brand        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  family               ProductFamily?           @relation(fields: [familyId], references: [id])
  bundles              Bundle[]
  lots                 StockLot[]
  preRegistrations     InboundPreRegistration[]
  purchaseLines        PurchaseLine[]
  quoteLines           QuoteLine[]
  orderLines           SalesOrderLine[]
  materialRequestLines MaterialRequestLine[]

  @@index([familyId])
  @@map("references")
}

model Finish {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bundles              Bundle[]
  lots                 StockLot[]
  preRegistrations     InboundPreRegistration[]
  purchaseLines        PurchaseLine[]
  quoteLines           QuoteLine[]
  orderLines           SalesOrderLine[]
  materialRequestLines MaterialRequestLine[]

  @@map("finishes")
}

model User {
  id                         String   @id @default(cuid())
  name                       String
  // Login name, e.g. «pedro.alvarez»: lowercase letters, digits and . _ -
  // (CHECK). Users created without one (scripts, tests) get a random
  // «usuario.xxxxxxxxxx» from the database; the administrator can change it.
  username                   String   @unique @default(dbgenerated("('usuario.'::text || substr(md5((random())::text), 1, 10))"))
  // Optional contact; still accepted to log in during the change to usernames.
  email                      String?  @unique
  passwordHash               String
  // The initial password (the user's ID number, set by the administrator) must
  // be replaced at the first login: until then only /auth/me and
  // /auth/change-password answer.
  mustChangePassword         Boolean  @default(false)
  // Sessions issued before this moment stop working (password changed or reset).
  passwordChangedAt          DateTime? @db.Timestamptz(3)
  role                       UserRole @default(READ_ONLY)
  defaultInventoryLocationId String?
  active                     Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  defaultInventoryLocation  InventoryLocation?       @relation(fields: [defaultInventoryLocationId], references: [id], onDelete: Restrict)
  movements                 InventoryMovement[]
  tasksAssigned             Task[]                   @relation("TaskAssignee")
  tasksCreated              Task[]                   @relation("TaskCreator")
  pushSubscriptions         PushSubscription[]
  shipmentsCreated          InboundShipment[]        @relation("ShipmentCreator")
  preRegistrationsCreated   InboundPreRegistration[] @relation("PreRegistrationCreator")
  preRegistrationsReceived  InboundPreRegistration[] @relation("PreRegistrationReceiver")
  lotsCreated               StockLot[]               @relation("LotCreator")
  purchasesCreated          Purchase[]               @relation("PurchaseCreator")
  purchasesConfirmed        Purchase[]               @relation("PurchaseConfirmer")
  salePricesCreated         SalePrice[]              @relation("SalePriceCreator")
  customersCreated          Customer[]               @relation("CustomerCreator")
  quotesCreated             Quote[]                  @relation("QuoteCreator")
  discountsRequested        QuoteDiscountRequest[]   @relation("DiscountRequester")
  discountsToApprove        QuoteDiscountRequest[]   @relation("DiscountApprover")
  quoteLinePricesApproved   QuoteLine[]              @relation("QuoteLinePriceApprover")
  orderLinePricesApproved   SalesOrderLine[]         @relation("OrderLinePriceApprover")
  ordersCreated             SalesOrder[]             @relation("OrderCreator")
  ordersConverted           SalesOrder[]             @relation("OrderConverter")
  orderPaymentStatuses      SalesOrder[]             @relation("OrderPaymentStatus")
  orderPaymentsCreated      SalesOrderPayment[]      @relation("OrderPaymentCreator")
  orderPaymentsEdited       SalesOrderPayment[]      @relation("OrderPaymentEditor")
  billedOrders              SalesOrder[]             @relation("OrderBilledBy")
  bundlesOpened             Bundle[]                 @relation("BundleOpener")
  reservationsCreated       StockReservation[]       @relation("ReservationCreator")
  dispatchesCreated         Dispatch[]               @relation("DispatchCreator")
  dispatchesAssigned        Dispatch[]               @relation("DispatchAssignee")
  dispatchesConfirmed       Dispatch[]               @relation("DispatchConfirmer")
  picksCreated              DispatchPick[]           @relation("PickCreator")
  incidentsResolved         DispatchIncident[]       @relation("IncidentResolver")
  notifications             NotificationOutbox[]
  readerDevicesCreated      ReaderDevice[]           @relation("ReaderDeviceCreator")
  readerSessionsOpened      ReaderSession[]          @relation("ReaderSessionOpener")
  readerObservations        ReaderObservation[]
  auditEvents               AuditEvent[]
  materialRequestsAssigned  MaterialRequest[]        @relation("MaterialRequestAssignee")
  materialRequestsCreated   MaterialRequest[]        @relation("MaterialRequestCreator")
  materialRequestsShipped   MaterialRequest[]        @relation("MaterialRequestShipper")
  materialRequestsReceived  MaterialRequest[]        @relation("MaterialRequestReceiver")
  materialRequestsCancelled MaterialRequest[]        @relation("MaterialRequestCanceller")
  materialRequestPicks      MaterialRequestPick[]
  accessoryVouchers         AccessoryVoucher[]
  returnsRequested          SalesReturn[]            @relation("ReturnRequester")
  returnsToApprove          SalesReturn[]            @relation("ReturnApprover")
  returnsDecided            SalesReturn[]            @relation("ReturnDecider")
  returnsToReceive          SalesReturn[]            @relation("ReturnReceiver")
  returnsReceived           SalesReturn[]            @relation("ReturnReceivedBy")
  returnsRefunded           SalesReturn[]            @relation("ReturnRefundedBy")
  returnsCreditNotes        SalesReturn[]            @relation("ReturnCreditNoteBy")
  returnsCancelled          SalesReturn[]            @relation("ReturnCancelledBy")
  loginEvents               LoginEvent[]             @relation("LoginEventUser")
  loginEventsActed          LoginEvent[]             @relation("LoginEventActor")

  @@index([defaultInventoryLocationId])
  @@map("users")
}

model Bundle {
  id                   String               @id @default(cuid())
  epc                  String               @unique
  referenceId          String
  finishId             String
  quantity             Int
  inventoryLocationId  String
  rackId               String?
  arrivalDate          DateTime?            @db.Date
  arrivalYear          Int?
  arrivalMonth         Int?
  arrivalDatePrecision ArrivalDatePrecision @default(UNKNOWN)
  notes                String?
  // Canonical origin, supplier and acquisition cost come from the lot. null:
  // historical stock with unknown origin (never assumed Chinese).
  lotId                String?
  // Opened bundle: from then on `quantity` are LOOSE profiles in its location
  // (no new chip; the bundle, its EPC and history stay as antecedents). A
  // bundle is opened once (trigger bundle_opened_is_final).
  openedAt             DateTime?            @db.Timestamptz(3)
  openedById           String?
  // Accessory basket (docs/accesorios-fase-1.md): a fixed basket of the
  // accessories warehouse with one chip, refilled by entries and taken by
  // parts. One per reference, finish and location (partial unique index).
  // Never opened nor transferred; only the accessories flows move it.
  basket               Boolean              @default(false)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)

  reference         Reference               @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  finish            Finish                  @relation(fields: [finishId], references: [id], onDelete: Restrict)
  inventoryLocation InventoryLocation       @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  rack              Rack?                   @relation(fields: [rackId], references: [id], onDelete: Restrict)
  lot               StockLot?               @relation(fields: [lotId], references: [id], onDelete: Restrict)
  openedBy          User?                   @relation("BundleOpener", fields: [openedById], references: [id], onDelete: Restrict)
  movements         InventoryMovement[]
  preRegistration   InboundPreRegistration?
  reservations      StockReservation[]
  picks             DispatchPick[]
  materialPicks     MaterialRequestPick[]

  @@index([referenceId, finishId, inventoryLocationId])
  @@index([lotId])
  @@index([finishId])
  @@index([inventoryLocationId])
  @@index([rackId])
  @@map("bundles")
}

model InventoryMovement {
  id                    String                @id @default(cuid())
  bundleId              String
  type                  InventoryMovementType
  quantity              Int
  quantityBefore        Int
  quantityAfter         Int
  sourceLocationId      String?
  destinationLocationId String?
  sourceRackId          String?
  destinationRackId     String?
  occurredAt            DateTime              @db.Timestamptz(3)
  performedById         String
  reason                String?
  operationKey          String                @unique
  // Set on exits confirmed by a dispatch (traceability to the sales order).
  dispatchId            String?
  // Set on transfers shipped for a material request (warehouse → branch).
  materialRequestId     String?
  // Set on the ENTRY / EXIT movements of an accessory voucher (its lines).
  accessoryVoucherId    String?
  // Set on RETURN movements (and only on them): the line of the sales return.
  salesReturnLineId     String?
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  bundle              Bundle             @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  dispatch            Dispatch?          @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  materialRequest     MaterialRequest?   @relation(fields: [materialRequestId], references: [id], onDelete: Restrict)
  accessoryVoucher    AccessoryVoucher?  @relation(fields: [accessoryVoucherId], references: [id], onDelete: Restrict)
  salesReturnLine     SalesReturnLine?   @relation(fields: [salesReturnLineId], references: [id], onDelete: Restrict)
  performedBy         User               @relation(fields: [performedById], references: [id], onDelete: Restrict)
  sourceLocation      InventoryLocation? @relation("MovementSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation InventoryLocation? @relation("MovementDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  sourceRack          Rack?              @relation("MovementSourceRack", fields: [sourceRackId], references: [id], onDelete: Restrict)
  destinationRack     Rack?              @relation("MovementDestinationRack", fields: [destinationRackId], references: [id], onDelete: Restrict)

  @@index([bundleId, occurredAt])
  @@index([performedById])
  @@index([type, occurredAt])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([sourceRackId])
  @@index([destinationRackId])
  @@index([dispatchId])
  @@index([materialRequestId])
  @@index([accessoryVoucherId])
  @@index([salesReturnLineId])
  @@map("inventory_movements")
}

// TASKS: a task is assigned to one user. Employees create their own; ADMIN
// (the boss) can assign to anyone. Status is derived, never stored:
//   completed  -> completedAt set
//   incomplete -> not completed and dueAt has passed (leaves the active list,
//                 kept as history in the incomplete list)
//   pending    -> otherwise
// DISPATCH tasks are linked to a dispatch: they are completed only by
// confirming the dispatch (never by the generic "complete" route), stay
// pending while overdue and are cancelled with their dispatch.
// DISPATCH and DISCOUNT_APPROVAL tasks are completed by their own flow
// (confirming the dispatch / answering the discount request), never by hand.
enum TaskKind {
  GENERAL
  DISPATCH
  DISCOUNT_APPROVAL
  // Material requests: prepare and ship (warehouse) / mark received (branch).
  MATERIAL_REQUEST
  MATERIAL_RECEPTION
  // Invoice a sales order (completed by recording the invoice number).
  BILLING
  // Notice to the administrator of an accessory voucher (entry or exit
  // without a sale). Nothing to authorise: marked as seen.
  ACCESSORY_NOTICE
  // Sales returns: authorise (admin), receive (warehouse) and the credit
  // note of an invoiced order (billing). Completed by their flow.
  RETURN_APPROVAL
  RETURN_RECEPTION
  CREDIT_NOTE
}

model Task {
  id                String    @id @default(cuid())
  title             String
  description       String?
  dueAt             DateTime  @db.Timestamptz(3)
  assigneeId        String
  createdById       String
  completedAt       DateTime? @db.Timestamptz(3)
  kind              TaskKind  @default(GENERAL)
  dispatchId        String?   @unique
  // DISCOUNT_APPROVAL tasks only (CHECK): the request the admin answers.
  discountRequestId String?   @unique
  // MATERIAL_REQUEST / MATERIAL_RECEPTION tasks only (CHECK).
  materialRequestId String?
  // BILLING tasks only (CHECK): the order to invoice.
  salesOrderId      String?
  // ACCESSORY_NOTICE tasks only (CHECK): the voucher the administrator sees.
  accessoryVoucherId String?  @unique
  // RETURN_APPROVAL, RETURN_RECEPTION and CREDIT_NOTE tasks only (CHECK).
  salesReturnId     String?
  cancelledAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  assignee        User                  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  dispatch        Dispatch?             @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  discountRequest QuoteDiscountRequest? @relation(fields: [discountRequestId], references: [id], onDelete: Restrict)
  materialRequest MaterialRequest?      @relation(fields: [materialRequestId], references: [id], onDelete: Restrict)
  salesOrder      SalesOrder?           @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  accessoryVoucher AccessoryVoucher?    @relation(fields: [accessoryVoucherId], references: [id], onDelete: Restrict)
  salesReturn     SalesReturn?          @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)

  // One preparation task and one reception task per request.
  @@unique([materialRequestId, kind])
  // One billing task per order (reopened if billing is requested again).
  @@unique([salesOrderId, kind])
  // One task of each kind per sales return.
  @@unique([salesReturnId, kind])
  @@index([assigneeId, completedAt, dueAt])
  @@index([createdById])
  @@index([dueAt])
  @@map("tasks")
}

// WEB PUSH: one row per browser/device subscription. The endpoint (a URL of
// the browser's push service) identifies the device and belongs to a single
// account at a time; a user may have several devices. Rows are removed on
// logout from that device or when the push service reports them invalid.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  lastSuccessAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ==========================================================================
// SUPPLY: suppliers, configuration, China pre-registration, lots, purchases
// ==========================================================================

// Administrative settings (e.g. the fixed Chinese supplier, the dispatch
// supervisor). Values are ids or plain text, never secrets.
model Setting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

model Supplier {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  taxId     String?
  // Origins this supplier may provide (a supplier is not an origin).
  origins   MaterialOrigin[]
  active    Boolean          @default(true)
  notes     String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  lots                 StockLot[]
  shipments            InboundShipment[]
  purchases            Purchase[]
  quoteLines           QuoteLine[]
  orderLines           SalesOrderLine[]
  materialRequestLines MaterialRequestLine[]

  @@map("suppliers")
}

enum ShipmentStatus {
  OPEN
  CLOSED
}

// Grouping of China pre-registrations (set by administration, not per chip).
model InboundShipment {
  id          String         @id @default(cuid())
  code        String         @unique
  supplierId  String
  status      ShipmentStatus @default(OPEN)
  notes       String?
  createdById String
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  closedAt    DateTime?      @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  supplier         Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy        User                     @relation("ShipmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lots             StockLot[]
  preRegistrations InboundPreRegistration[]

  @@index([supplierId, status])
  @@map("inbound_shipments")
}

enum LotKind {
  CHINA_SHIPMENT
  MANUAL_ENTRY
  OPENING
  // Lot of an accessory basket: only its origin (a basket is refilled by many
  // purchases of one origin; no supplier nor cost here).
  ACCESSORY_BASKET
}

// Accessory vouchers: an entry (purchase put in the baskets, with its
// support) or an exit without a sale. Their lines are the movements.
enum AccessoryVoucherKind {
  ENTRY
  EXIT
}

enum AccessoryExitType {
  // Sold outside the system (detail required).
  UNREGISTERED_SALE
  INTERNAL_USE
}

// Canonical provenance and acquisition cost of a group of bundles: one
// reference, one finish, one origin, at most one supplier. unitCost is the
// confirmed cost per profile in COP; null = cost pending (never zero).
model StockLot {
  id              String         @id @default(cuid())
  code            String         @unique
  kind            LotKind
  referenceId     String
  finishId        String
  origin          MaterialOrigin
  supplierId      String?
  shipmentId      String?
  entryKey        String?
  purchaseLineId  String?
  unitCost        Decimal?       @db.Decimal(18, 6)
  costConfirmedAt DateTime?      @db.Timestamptz(3)
  notes           String?
  createdById     String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  reference        Reference                @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  finish           Finish                   @relation(fields: [finishId], references: [id], onDelete: Restrict)
  supplier         Supplier?                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  shipment         InboundShipment?         @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  purchaseLine     PurchaseLine?            @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  createdBy        User                     @relation("LotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  bundles          Bundle[]
  preRegistrations InboundPreRegistration[]

  @@unique([shipmentId, referenceId, finishId])
  @@unique([entryKey, referenceId, finishId])
  @@index([referenceId, finishId, origin, supplierId])
  @@index([purchaseLineId])
  @@map("stock_lots")
}

enum PreRegistrationStatus {
  PENDING
  RECEIVED
  CANCELLED
}

// A bundle announced from China (EPC + expected contents). It is NOT stock in
// Colombia: the Bundle is created only when it is received.
model InboundPreRegistration {
  id                String                @id @default(cuid())
  epc               String
  lotId             String
  shipmentId        String
  referenceId       String
  finishId          String
  expectedQuantity  Int
  status            PreRegistrationStatus @default(PENDING)
  operationKey      String                @unique
  createdById       String
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  receivedBundleId  String?               @unique
  receivedQuantity  Int?
  receivedAt        DateTime?             @db.Timestamptz(3)
  receivedById      String?
  discrepancyReason String?
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)

  lot            StockLot        @relation(fields: [lotId], references: [id], onDelete: Restrict)
  shipment       InboundShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  reference      Reference       @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  finish         Finish          @relation(fields: [finishId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("PreRegistrationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  receivedBy     User?           @relation("PreRegistrationReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedBundle Bundle?         @relation(fields: [receivedBundleId], references: [id], onDelete: Restrict)

  @@index([epc])
  @@index([createdById, createdAt])
  @@index([shipmentId])
  @@map("inbound_pre_registrations")
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

// Supplier document. Amounts in the document currency (2 decimals); COP
// conversions keep the applied rate, its date and source. Computed fields
// are recalculated on every draft save and frozen on confirmation.
model Purchase {
  id                      String         @id @default(cuid())
  supplierId              String
  documentNumber          String
  documentDate            DateTime       @db.Date
  currency                String         @default("COP") @db.Char(3)
  exchangeRate            Decimal?       @db.Decimal(18, 6)
  exchangeRateDate        DateTime?      @db.Date
  exchangeRateSource      String?
  globalDiscountType      DiscountType   @default(NONE)
  globalDiscountValue     Decimal        @default(0) @db.Decimal(18, 4)
  // Conditional discounts (e.g. prompt payment) are recorded, not deducted
  // from cost: their treatment needs an accounting policy.
  conditionalDiscountNote String?
  status                  PurchaseStatus @default(DRAFT)
  notes                   String?
  grossTotal              Decimal        @default(0) @db.Decimal(18, 2)
  lineDiscountTotal       Decimal        @default(0) @db.Decimal(18, 2)
  globalDiscountTotal     Decimal        @default(0) @db.Decimal(18, 2)
  netTotal                Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal                Decimal        @default(0) @db.Decimal(18, 2)
  chargesTotal            Decimal        @default(0) @db.Decimal(18, 2)
  documentTotal           Decimal        @default(0) @db.Decimal(18, 2)
  createdById             String
  confirmedById           String?
  confirmedAt             DateTime?      @db.Timestamptz(3)
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @db.Timestamptz(3)

  supplier    Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy User?            @relation("PurchaseConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  lines       PurchaseLine[]
  charges     PurchaseCharge[]

  @@unique([supplierId, documentNumber])
  @@map("purchases")
}

model PurchaseLine {
  id                   String         @id @default(cuid())
  purchaseId           String
  lineNo               Int
  referenceId          String
  finishId             String
  origin               MaterialOrigin
  // Purchase unit and its explicit equivalence in profiles (1 for "perfil").
  unitName             String
  profilesPerUnit      Decimal        @db.Decimal(18, 3)
  quantity             Decimal        @db.Decimal(18, 3)
  unitPrice            Decimal        @db.Decimal(18, 6)
  lineDiscountType     DiscountType   @default(NONE)
  lineDiscountValue    Decimal        @default(0) @db.Decimal(18, 4)
  // Explicit per line (no universal rate); required to confirm.
  taxRatePercent       Decimal?       @db.Decimal(9, 4)
  taxRecoverable       Boolean?
  grossAmount          Decimal        @default(0) @db.Decimal(18, 2)
  lineDiscountAmount   Decimal        @default(0) @db.Decimal(18, 2)
  globalDiscountAmount Decimal        @default(0) @db.Decimal(18, 2)
  netAmount            Decimal        @default(0) @db.Decimal(18, 2)
  taxAmount            Decimal        @default(0) @db.Decimal(18, 2)
  chargesAmount        Decimal        @default(0) @db.Decimal(18, 2)
  costAmount           Decimal        @default(0) @db.Decimal(18, 2)
  costAmountCop        Decimal        @default(0) @db.Decimal(18, 2)
  profiles             Int            @default(0)
  unitCostCop          Decimal?       @db.Decimal(18, 6)
  // true: grossAmount is the supplier's value WITH purchase VAT and the cost
  // per profile is (gross - discount) / profiles. false: the earlier
  // definition (net + charges + non-recoverable tax); kept as recorded.
  grossIncludesTax     Boolean        @default(false)
  // true (current rule): grossAmount WITHOUT purchase VAT, as on the invoice;
  // discount on it, VAT (taxRatePercent) on the discounted base, and the cost
  // per profile = (base + VAT) / profiles. Never true together with
  // grossIncludesTax (CHECK purchase_lines_one_cost_rule).
  taxOnNet             Boolean        @default(false)

  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  reference  Reference   @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  finish     Finish      @relation(fields: [finishId], references: [id], onDelete: Restrict)
  lots       StockLot[]
  salePrices SalePrice[]

  @@unique([purchaseId, lineNo])
  // Target of SalePrice: a price can only point to a line of its own material.
  @@unique([id, referenceId, finishId, origin])
  @@map("purchase_lines")
}

// Sale price of ONE purchase line: its cost per profile (purchase VAT
// included) plus a profit on that cost. Immutable: another margin is another
// price. Sales receive the price ENABLED for a reference, finish and origin
// (at most one, partial unique index); prices of other purchases are kept.
model SalePrice {
  id             String         @id @default(cuid())
  purchaseLineId String
  referenceId    String
  finishId       String
  origin         MaterialOrigin
  unitCost       Decimal        @db.Decimal(18, 6)
  markupPercent  Decimal        @db.Decimal(9, 4)
  unitPrice      Decimal        @db.Decimal(18, 2)
  enabled        Boolean        @default(false)
  enabledAt      DateTime?      @db.Timestamptz(3)
  disabledAt     DateTime?      @db.Timestamptz(3)
  createdById    String
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  purchaseLine PurchaseLine     @relation(fields: [purchaseLineId, referenceId, finishId, origin], references: [id, referenceId, finishId, origin], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User             @relation("SalePriceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  quoteLines   QuoteLine[]
  orderLines   SalesOrderLine[]

  @@index([referenceId, finishId, origin])
  @@index([purchaseLineId])
  @@map("sale_prices")
}

// Attributable acquisition costs (freight, handling…), distributed over the
// lines in proportion to their net amount.
model PurchaseCharge {
  id          String   @id @default(cuid())
  purchaseId  String
  description String
  amount      Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchase_charges")
}

// ==========================================================================
// SALES: customers, quotes, orders, reservations
// ==========================================================================

model Customer {
  id          String   @id @default(cuid())
  name        String
  taxId       String?
  phone       String?
  email       String?
  address     String?
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  createdBy User         @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  quotes    Quote[]
  orders    SalesOrder[]
  returns   SalesReturn[]

  @@index([name])
  @@map("customers")
}

enum QuoteStatus {
  DRAFT
  CONVERTED
  CANCELLED
}

enum PricingMethod {
  // price = cost × (1 + p)
  MARKUP_ON_COST
  // price = cost ÷ (1 − p)
  GROSS_MARGIN
  // authorised commercial price with a reason
  MANUAL
}

// Kind of sale of a quote / order: «Detal» (materials) or «Ventanería»
// (materials plus, optionally, assembly and installation services).
enum SaleType {
  RETAIL
  WINDOWS
}

// How the customer pays a quote / order (agreed terms, not a payment record).
enum PaymentMethod {
  CASH // Contado – efectivo
  TRANSFER // Contado – transferencia
  PARTIAL // Abono
  CREDIT // Cartera (crédito)
  // Contado repartido libremente entre efectivo y transferencia (la suma es
  // el total de la orden).
  CASH_TRANSFER
}

// Medium of money actually received: one payment record of an order.
enum PaymentMedium {
  CASH
  TRANSFER
  // The customer's credit from returns (saldo a favor, docs: devoluciones):
  // no money changes hands; the balance is derived (returns − payments).
  CREDIT_BALANCE
}

// Return of delivered material by the customer (documento DV).
// REQUESTED → (admin) APPROVED or REJECTED; APPROVED → (warehouse) RECEIVED.
// REQUESTED / APPROVED can be CANCELLED. RECEIVED is final.
enum SalesReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REJECTED
  CANCELLED
}

enum SalesReturnReason {
  SELLER_ERROR // Error del vendedor
  CUSTOMER_ERROR // El cliente se equivocó o cambió de idea
  WAREHOUSE_ERROR // Error de bodega
  DEFECTIVE // Material defectuoso
}

// What happens with the money the customer had already paid beyond the new
// net total of the order (the rest of the value just lowers its balance).
enum SalesReturnSettlement {
  CREDIT // Saldo a favor del cliente
  REFUND // Reintegro en efectivo o transferencia
}

// Collection state of an order paid by abono or on credit (cartera). Cash and
// transfer orders are paid at the sale and have no state (NULL).
enum PaymentStatus {
  PENDING
  PAID
}

// Quotes never reserve or move stock. Lines keep a copy of the conditions
// used (labels, cost basis, method, percent, taxes).
model Quote {
  id                    String         @id @default(cuid())
  number                String         @unique
  customerId            String
  customerName          String
  status                QuoteStatus    @default(DRAFT)
  validUntil            DateTime?      @db.Date
  currency              String         @default("COP") @db.Char(3)
  notes                 String?
  // Required on every save from now on; null only on quotes saved before.
  paymentMethod         PaymentMethod?
  // Free details agreed with the customer (advance amount, credit days…).
  paymentTerms          String?
  subtotal              Decimal        @default(0) @db.Decimal(18, 2)
  // Line discounts only; the global discount has its own fields.
  discountTotal         Decimal        @default(0) @db.Decimal(18, 2)
  // Discount on the whole quote, after line discounts and before VAT
  // (0, or 0.1–100 %). SALES applies up to 3 % alone; more needs an
  // approved QuoteDiscountRequest.
  globalDiscountPercent Decimal        @default(0) @db.Decimal(9, 4)
  globalDiscountAmount  Decimal        @default(0) @db.Decimal(18, 2)
  taxTotal              Decimal        @default(0) @db.Decimal(18, 2)
  // «Detal» (RETAIL) or «Ventanería» (WINDOWS). Ventanería may add the
  // assembly and installation of the window: amounts typed by the seller,
  // without VAT nor discounts, outside the material lines (no stock).
  saleType              SaleType       @default(RETAIL)
  assemblyAmount        Decimal        @default(0) @db.Decimal(18, 2)
  installationAmount    Decimal        @default(0) @db.Decimal(18, 2)
  // = subtotal − discountTotal − globalDiscountAmount + taxTotal
  //   + assemblyAmount + installationAmount = Σ lineTotal + services.
  total                 Decimal        @default(0) @db.Decimal(18, 2)
  createdById           String
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)

  customer         Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy        User                   @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lines            QuoteLine[]
  order            SalesOrder?
  discountRequests QuoteDiscountRequest[]

  @@index([createdById, createdAt])
  @@map("quotes")
}

//   PENDING   waiting for the chosen administrator (one per quote at most)
//   APPROVED  applied to the quote when approved
//   REJECTED  answered no (optional reason)
//   CANCELLED withdrawn by the seller, or the quote was cancelled
enum QuoteDiscountRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

//   GLOBAL_DISCOUNT  a global discount above the seller's limit
//   MANUAL_PRICE     the manual prices of the quote's lines
enum QuoteRequestKind {
  GLOBAL_DISCOUNT
  MANUAL_PRICE
}

// A seller asks an administrator THEY choose to authorise something on a
// quote: a global discount above their own limit, or its manual prices. It
// becomes a task of that administrator (task kind DISCOUNT_APPROVAL for both).
// At most one PENDING request of each kind per quote.
model QuoteDiscountRequest {
  id               String                     @id @default(cuid())
  quoteId          String
  kind             QuoteRequestKind           @default(GLOBAL_DISCOUNT)
  // GLOBAL_DISCOUNT only (CHECK).
  requestedPercent Decimal?                   @db.Decimal(9, 4)
  // MANUAL_PRICE: snapshot of the manual lines as requested and, once
  // approved, the prices the administrator set (audit trail).
  details          Json?
  // A newer request of the same kind that replaced this one (CANCELLED).
  replacedById     String?
  reason           String?
  status           QuoteDiscountRequestStatus @default(PENDING)
  requestedById    String
  approverId       String
  resolvedAt       DateTime?                  @db.Timestamptz(3)
  // Rejection reason of the administrator (optional).
  resolution       String?
  // When the seller saw the answer (in-app notice); null = not seen yet.
  requesterSeenAt  DateTime?                  @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(3)

  quote       Quote                  @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  requestedBy User                   @relation("DiscountRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approver    User                   @relation("DiscountApprover", fields: [approverId], references: [id], onDelete: Restrict)
  replacedBy  QuoteDiscountRequest?  @relation("RequestReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces    QuoteDiscountRequest[] @relation("RequestReplacement")
  task        Task?

  @@index([quoteId, createdAt])
  @@index([approverId, status])
  @@index([requestedById, requesterSeenAt])
  @@map("quote_discount_requests")
}

model QuoteLine {
  id                   String         @id @default(cuid())
  quoteId              String
  lineNo               Int
  referenceId          String
  finishId             String
  origin               MaterialOrigin
  supplierId           String?
  quantity             Int
  pricingMethod        PricingMethod
  pricingPercent       Decimal?       @db.Decimal(9, 4)
  costBasis            Decimal?       @db.Decimal(18, 6)
  costLotId            String?
  // MANUAL: why the price was set by hand (required, CHECK).
  priceReason          String?
  // MANUAL: purchase cost per profile estimated by the seller (optional),
  // shown to the administrator with the margin.
  estimatedUnitCost    Decimal?       @db.Decimal(18, 6)
  // MANUAL: who authorised the current price (null = not authorised yet;
  // the quote can neither be printed for the customer nor converted).
  manualApprovedById   String?
  manualApprovedAt     DateTime?      @db.Timestamptz(3)
  unitPrice            Decimal        @db.Decimal(18, 2)
  discountPercent      Decimal        @default(0) @db.Decimal(9, 4)
  taxRatePercent       Decimal        @db.Decimal(9, 4)
  lineSubtotal         Decimal        @db.Decimal(18, 2)
  discountAmount       Decimal        @db.Decimal(18, 2)
  // Share of the quote's global discount (on the base after the line
  // discount); VAT and the line total are computed after it.
  globalDiscountAmount Decimal        @default(0) @db.Decimal(18, 2)
  taxAmount            Decimal        @db.Decimal(18, 2)
  lineTotal            Decimal        @db.Decimal(18, 2)
  referenceCode        String
  referenceDescription String?
  finishCode           String
  finishDescription    String?
  supplierName         String?
  // Sale price used (and through it the purchase line). Null on lines saved
  // before prices were linked to purchases.
  salePriceId          String?

  quote            Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  reference        Reference  @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  finish           Finish     @relation(fields: [finishId], references: [id], onDelete: Restrict)
  supplier         Supplier?  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  salePrice        SalePrice? @relation(fields: [salePriceId], references: [id], onDelete: Restrict)
  manualApprovedBy User?      @relation("QuoteLinePriceApprover", fields: [manualApprovedById], references: [id], onDelete: Restrict)

  @@unique([quoteId, lineNo])
  @@map("quote_lines")
}

// Lifecycle only; fulfilment (reserved/dispatched) is derived from the
// reservations and confirmed dispatch lines.
//   DRAFT          converted from a quote, not confirmed yet
//   PENDING_SUPPLY confirmation found shortages: nothing reserved
//   CONFIRMED      every line fully reserved
//   COMPLETED      confirmed dispatches cover every line
//   CANCELLED      remaining reservations released
enum SalesOrderStatus {
  DRAFT
  PENDING_SUPPLY
  CONFIRMED
  COMPLETED
  CANCELLED
}

model SalesOrder {
  id                    String           @id @default(cuid())
  number                String           @unique
  quoteId               String?          @unique
  customerId            String
  customerName          String
  inventoryLocationId   String?
  status                SalesOrderStatus @default(DRAFT)
  currency              String           @default("COP") @db.Char(3)
  subtotal              Decimal          @db.Decimal(18, 2)
  discountTotal         Decimal          @db.Decimal(18, 2)
  // Copied from the quote (see Quote).
  globalDiscountPercent Decimal          @default(0) @db.Decimal(9, 4)
  globalDiscountAmount  Decimal          @default(0) @db.Decimal(18, 2)
  taxTotal              Decimal          @db.Decimal(18, 2)
  // Copied from the quote (see Quote): services are not lines, so they are
  // never reserved nor dispatched.
  saleType              SaleType         @default(RETAIL)
  assemblyAmount        Decimal          @default(0) @db.Decimal(18, 2)
  installationAmount    Decimal          @default(0) @db.Decimal(18, 2)
  total                 Decimal          @db.Decimal(18, 2)
  notes                 String?
  // Copied from the quote when it is converted.
  paymentMethod         PaymentMethod?
  paymentTerms          String?
  // Only for PARTIAL / CREDIT (CHECK): starts PENDING; the owner or ADMIN
  // marks it PAID (and back), each change audited.
  paymentStatus         PaymentStatus?
  paymentStatusAt       DateTime?        @db.Timestamptz(3)
  paymentStatusById     String?
  convertOperationKey   String           @unique
  // Owner (seller of the quote): decides who may see and act on the order.
  createdById           String
  // Who converted the quote into this order (null on orders made before).
  convertedById         String?
  confirmedAt           DateTime?        @db.Timestamptz(3)
  completedAt           DateTime?        @db.Timestamptz(3)
  cancelledAt           DateTime?        @db.Timestamptz(3)
  cancelReason          String?
  // Electronic invoice, made in another software: the seller marks that the
  // order needs one (a BILLING task is created) and the billing user records
  // the invoice number (CHECK: billed only if required; number, date and
  // author together).
  requiresBilling       Boolean          @default(false)
  billingRequestedAt    DateTime?        @db.Timestamptz(3)
  invoiceNumber         String?
  billedAt              DateTime?        @db.Timestamptz(3)
  billedById            String?
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  quote             Quote?             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  inventoryLocation InventoryLocation? @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  createdBy         User               @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  convertedBy       User?              @relation("OrderConverter", fields: [convertedById], references: [id], onDelete: Restrict)
  paymentStatusBy   User?              @relation("OrderPaymentStatus", fields: [paymentStatusById], references: [id], onDelete: Restrict)
  payments          SalesOrderPayment[]
  returns           SalesReturn[]
  billedBy          User?              @relation("OrderBilledBy", fields: [billedById], references: [id], onDelete: Restrict)
  lines             SalesOrderLine[]
  dispatches        Dispatch[]
  tasks             Task[]

  @@index([createdById, createdAt])
  @@index([status])
  @@index([requiresBilling, billedAt])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                   String         @id @default(cuid())
  salesOrderId         String
  lineNo               Int
  referenceId          String
  finishId             String
  origin               MaterialOrigin
  supplierId           String?
  quantity             Int
  unitPrice            Decimal        @db.Decimal(18, 2)
  discountPercent      Decimal        @db.Decimal(9, 4)
  taxRatePercent       Decimal        @db.Decimal(9, 4)
  lineSubtotal         Decimal        @db.Decimal(18, 2)
  discountAmount       Decimal        @db.Decimal(18, 2)
  globalDiscountAmount Decimal        @default(0) @db.Decimal(18, 2)
  taxAmount            Decimal        @db.Decimal(18, 2)
  lineTotal            Decimal        @db.Decimal(18, 2)
  referenceCode        String
  referenceDescription String?
  finishCode           String
  finishDescription    String?
  supplierName         String?
  // Copied from the quote line: the sale price (and purchase line) used.
  salePriceId          String?
  // Copied from a manual-price quote line: its reason and who authorised it.
  manualPrice          Boolean        @default(false)
  priceReason          String?
  manualApprovedById   String?

  salesOrder       SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  reference        Reference          @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  finish           Finish             @relation(fields: [finishId], references: [id], onDelete: Restrict)
  supplier         Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  salePrice        SalePrice?         @relation(fields: [salePriceId], references: [id], onDelete: Restrict)
  manualApprovedBy User?              @relation("OrderLinePriceApprover", fields: [manualApprovedById], references: [id], onDelete: Restrict)
  reservations     StockReservation[]
  dispatchLines    DispatchLine[]
  returnLines      SalesReturnLine[]

  @@unique([salesOrderId, lineNo])
  @@map("sales_order_lines")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

// Profiles of one bundle committed to one order line (optionally already
// assigned to a dispatch line). Available = bundle.quantity − ACTIVE
// reservations; a trigger keeps ACTIVE reservations ≤ bundle.quantity.
model StockReservation {
  id                    String            @id @default(cuid())
  bundleId              String
  // Exactly one of: a sales order line, or a material request line (CHECK).
  salesOrderLineId      String?
  materialRequestLineId String?
  dispatchLineId        String?
  quantity              Int
  status                ReservationStatus @default(ACTIVE)
  createdById           String
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  closedAt              DateTime?         @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  bundle              Bundle               @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  salesOrderLine      SalesOrderLine?      @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  materialRequestLine MaterialRequestLine? @relation(fields: [materialRequestLineId], references: [id], onDelete: Restrict)
  dispatchLine        DispatchLine?        @relation(fields: [dispatchLineId], references: [id], onDelete: Restrict)
  createdBy           User                 @relation("ReservationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([bundleId, status])
  @@index([salesOrderLineId, status])
  @@index([materialRequestLineId, status])
  @@index([dispatchLineId, status])
  @@map("stock_reservations")
}

// ==========================================================================
// DISPATCH: authorised delivery from one location, its task and picking
// ==========================================================================

enum DispatchStatus {
  OPEN
  CONFIRMED
  CANCELLED
}

model Dispatch {
  id                  String         @id @default(cuid())
  number              String         @unique
  salesOrderId        String
  inventoryLocationId String
  assigneeId          String
  dueAt               DateTime       @db.Timestamptz(3)
  status              DispatchStatus @default(OPEN)
  // Authorised partial delivery of an order that was not fully reserved.
  partial             Boolean        @default(false)
  createOperationKey  String         @unique
  confirmOperationKey String?        @unique
  createdById         String
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  confirmedAt         DateTime?      @db.Timestamptz(3)
  confirmedById       String?
  cancelledAt         DateTime?      @db.Timestamptz(3)
  cancelReason        String?
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  salesOrder        SalesOrder           @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  inventoryLocation InventoryLocation    @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  assignee          User                 @relation("DispatchAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy         User                 @relation("DispatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy       User?                @relation("DispatchConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  lines             DispatchLine[]
  picks             DispatchPick[]
  incidents         DispatchIncident[]
  task              Task?
  movements         InventoryMovement[]
  readerSessions    ReaderSession[]
  observations      ReaderObservation[]
  notifications     NotificationOutbox[]

  @@index([salesOrderId])
  @@index([assigneeId, status])
  @@index([inventoryLocationId, status])
  @@map("dispatches")
}

model DispatchLine {
  id                 String @id @default(cuid())
  dispatchId         String
  salesOrderLineId   String
  quantity           Int
  // Confirmed delivery; set only by the dispatch confirmation.
  dispatchedQuantity Int    @default(0)

  dispatch       Dispatch           @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  salesOrderLine SalesOrderLine     @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  reservations   StockReservation[]
  picks          DispatchPick[]

  @@unique([dispatchId, salesOrderLineId])
  @@map("dispatch_lines")
}

// Bundle prepared for a dispatch line with an explicit quantity of profiles.
// Re-reading the same EPC never adds the bundle again.
model DispatchPick {
  id             String   @id @default(cuid())
  dispatchId     String
  dispatchLineId String
  bundleId       String
  quantity       Int
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  dispatch     Dispatch     @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  dispatchLine DispatchLine @relation(fields: [dispatchLineId], references: [id], onDelete: Restrict)
  bundle       Bundle       @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("PickCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([dispatchId, bundleId])
  @@map("dispatch_picks")
}

enum IncidentKind {
  UNKNOWN_EPC
  WRONG_MATERIAL
  WRONG_ORIGIN
  WRONG_SUPPLIER
  UNKNOWN_ORIGIN
  WRONG_LOCATION
  INSUFFICIENT
  NOT_AVAILABLE
  ALREADY_DISPATCHED
  OTHER
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

// Discrepancy found while preparing a dispatch. Repeated reads of the same
// chip update `occurrences` instead of opening new incidents.
model DispatchIncident {
  id           String         @id @default(cuid())
  dispatchId   String
  kind         IncidentKind
  epc          String
  bundleId     String?
  message      String
  status       IncidentStatus @default(OPEN)
  occurrences  Int            @default(1)
  source       String
  firstSeenAt  DateTime       @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime       @default(now()) @db.Timestamptz(3)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?      @db.Timestamptz(3)

  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  resolvedBy User?    @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([dispatchId, status])
  @@map("dispatch_incidents")
}

// ==========================================================================
// NOTIFICATIONS: persistent outbox written in the same transaction as the
// business change; a worker delivers it with Web Push (bounded retries).
// ==========================================================================

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model NotificationOutbox {
  id            String       @id @default(cuid())
  userId        String
  kind          String
  dedupeKey     String       @unique
  dispatchId    String?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  sentAt        DateTime?    @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dispatch Dispatch? @relation(fields: [dispatchId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

// ==========================================================================
// RFID READERS (phase 2): fixed readers send observations to the same
// dispatch validation; they never move stock by themselves.
// ==========================================================================

model ReaderDevice {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String
  inventoryLocationId String
  // scrypt hash of the device secret (shown once on creation).
  secretHash          String
  active              Boolean   @default(true)
  simulator           Boolean   @default(false)
  createdById         String
  lastSeenAt          DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  inventoryLocation InventoryLocation   @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  createdBy         User                @relation("ReaderDeviceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sessions          ReaderSession[]
  events            ReaderEvent[]
  observations      ReaderObservation[]

  @@map("reader_devices")
}

enum ReaderSessionStatus {
  OPEN
  CLOSED
}

// Explicit association between a reader and an authorised dispatch.
model ReaderSession {
  id         String              @id @default(cuid())
  deviceId   String
  dispatchId String
  status     ReaderSessionStatus @default(OPEN)
  openedById String
  openedAt   DateTime            @default(now()) @db.Timestamptz(3)
  closedAt   DateTime?           @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)

  device       ReaderDevice        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  dispatch     Dispatch            @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  openedBy     User                @relation("ReaderSessionOpener", fields: [openedById], references: [id], onDelete: Restrict)
  observations ReaderObservation[]

  @@index([deviceId, status])
  @@map("reader_sessions")
}

// Event ids already received from a device (replays are ignored).
model ReaderEvent {
  deviceId   String
  eventId    String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  device ReaderDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, eventId])
  @@map("reader_events")
}

// One row per chip and capture context (handheld user or reader session),
// with a counter: thousands of radio detections do not create thousands of
// rows, movements or notifications.
model ReaderObservation {
  id          String   @id @default(cuid())
  dispatchId  String
  contextKey  String
  source      String
  deviceId    String?
  sessionId   String?
  userId      String?
  epc         String
  result      String
  count       Int      @default(1)
  firstSeenAt DateTime @db.Timestamptz(3)
  lastSeenAt  DateTime @db.Timestamptz(3)
  antenna     Int?
  rssi        Int?

  dispatch Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  device   ReaderDevice?  @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  session  ReaderSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  user     User?          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, contextKey, epc])
  @@map("reader_observations")
}

// Audit trail of administrative corrections and exceptions (lot
// classification, cost links, quantity discrepancies, manual prices,
// cancellations, incident resolutions).
model AuditEvent {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  action   String
  data     Json?
  reason   String?
  userId   String?
  at       DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@map("audit_events")
}

// ==========================================================================
// MATERIAL REQUESTS: internal supply of a branch from a warehouse
// ==========================================================================
// Sales asks a warehouse (e.g. Bodega 116) for profiles for a branch (e.g.
// Almacén 7 de agosto) with lines like a quote's, without prices, chips or
// bundles. A warehouse worker (in turn, or the one Sales chose) prepares it
// by reading the chips of WHOLE bundles (each picked bundle is reserved
// entirely), then confirms the physical shipment: the bundles are
// transferred to the destination (and opened there when it is a retail
// store). The branch marks the request received. Creating or sending it
// never moves inventory.

enum MaterialRequestStatus {
  SENT
  PREPARING
  SHIPPED
  RECEIVED
  CANCELLED
}

model MaterialRequest {
  id                    String                @id @default(cuid())
  number                String                @unique
  status                MaterialRequestStatus @default(SENT)
  sourceLocationId      String
  destinationLocationId String
  dueAt                 DateTime              @db.Timestamptz(3)
  notes                 String?
  // Warehouse worker who prepares it (taken in turn, changeable by Sales).
  assigneeId            String
  // Retry of the same send (double click, lost answer) creates nothing new.
  createOperationKey    String                @unique
  createdById           String
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  shipOperationKey      String?               @unique
  shippedAt             DateTime?             @db.Timestamptz(3)
  shippedById           String?
  receivedAt            DateTime?             @db.Timestamptz(3)
  receivedById          String?
  receptionNote         String?
  cancelledAt           DateTime?             @db.Timestamptz(3)
  cancelledById         String?
  cancelReason          String?

  source      InventoryLocation     @relation("MaterialRequestSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destination InventoryLocation     @relation("MaterialRequestDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  assignee    User                  @relation("MaterialRequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy   User                  @relation("MaterialRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  shippedBy   User?                 @relation("MaterialRequestShipper", fields: [shippedById], references: [id], onDelete: Restrict)
  receivedBy  User?                 @relation("MaterialRequestReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  cancelledBy User?                 @relation("MaterialRequestCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines       MaterialRequestLine[]
  picks       MaterialRequestPick[]
  tasks       Task[]
  movements   InventoryMovement[]

  @@index([status, createdAt])
  @@index([sourceLocationId, createdAt])
  @@index([createdById, createdAt])
  @@index([assigneeId, status])
  @@map("material_requests")
}

// What is asked: profiles of a reference and colour with the origin (and
// supplier, when required) the material must have.
model MaterialRequestLine {
  id                   String         @id @default(cuid())
  requestId            String
  lineNo               Int
  referenceId          String
  finishId             String
  origin               MaterialOrigin
  supplierId           String?
  // Profiles asked (not bundles).
  quantity             Int
  referenceCode        String
  referenceDescription String?
  finishCode           String
  finishDescription    String?
  supplierName         String?

  request      MaterialRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  reference    Reference             @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  finish       Finish                @relation(fields: [finishId], references: [id], onDelete: Restrict)
  supplier     Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  picks        MaterialRequestPick[]
  reservations StockReservation[]

  @@unique([requestId, lineNo])
  @@map("material_request_lines")
}

// A whole bundle prepared for a line (its quantity when picked); reserved
// entirely until shipped or removed.
model MaterialRequestPick {
  id            String   @id @default(cuid())
  requestId     String
  requestLineId String
  bundleId      String
  quantity      Int
  createdById   String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  request     MaterialRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  requestLine MaterialRequestLine @relation(fields: [requestLineId], references: [id], onDelete: Restrict)
  bundle      Bundle              @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([requestId, bundleId])
  @@index([bundleId])
  @@index([requestLineId])
  @@map("material_request_picks")
}

// Accessory voucher (docs/accesorios-fase-1.md): an entry of purchased units
// into the baskets (IA-…, with its support) or an exit without a sale
// (SS-…, with its type and detail). Its lines are the ENTRY / EXIT movements
// that point to it, one per basket. Never edited nor deleted; the
// administrator corrects with an adjustment. Each one leaves an
// ACCESSORY_NOTICE task to the administrator.
model AccessoryVoucher {
  id                  String               @id @default(cuid())
  number              String               @unique
  kind                AccessoryVoucherKind
  inventoryLocationId String
  // ENTRY only (CHECK): who sold it, invoice or delivery note, arrival day.
  supplierName        String?
  documentNumber      String?
  arrivalDate         DateTime?            @db.Date
  // EXIT only (CHECK): why it left and the detail (always required).
  exitType            AccessoryExitType?
  detail              String?
  receivedBy          String?
  notes               String?
  operationKey        String               @unique
  createdById         String
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)

  inventoryLocation InventoryLocation   @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  createdBy         User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  movements         InventoryMovement[]
  task              Task?

  @@index([kind, createdAt])
  @@index([inventoryLocationId])
  @@index([createdById])
  @@map("accessory_vouchers")
}

// Money received for a sales order: one record per payment (contado, split
// in cash and transfer, or each abono), with its own amount, day and medium.
// The order total never changes; paid = Σ amount ≤ total (trigger) and the
// balance is total − paid. Abono / cartera orders with records derive their
// payment status from them (PAID when the balance is zero). Corrections edit
// the record (never a new payment) and are audited (PAYMENT_EDITED).
// Orders converted before this table have no records: nothing is invented.
model SalesOrderPayment {
  id           String        @id @default(cuid())
  salesOrderId String
  medium       PaymentMedium
  amount       Decimal       @db.Decimal(18, 2)
  // Day the money was received (business day, chosen by the user).
  paidOn       DateTime      @db.Date
  note         String?
  // Recorded with the conversion of a contado order (its amount is fixed:
  // the contado always adds up to the order total).
  atSale       Boolean       @default(false)
  // Transfers only (CHECK): where Solaluminios received the money (its
  // account), for reports per entity. Required for every new transfer and
  // when a payment becomes a transfer (trigger); null on a transfer means
  // «Sin especificar» (recorded before the entity was asked). Cash: null.
  transferEntityId String?
  operationKey String        @unique
  createdById  String
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  // Last correction (null: never edited); every change is in audit_events.
  updatedById  String?
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  salesOrder     SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("OrderPaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?           @relation("OrderPaymentEditor", fields: [updatedById], references: [id], onDelete: Restrict)
  transferEntity TransferEntity? @relation(fields: [transferEntityId], references: [id], onDelete: Restrict)

  @@index([salesOrderId, paidOn])
  @@index([createdById])
  @@index([updatedById])
  @@index([transferEntityId, paidOn])
  @@map("sales_order_payments")
}

// Entities where Solaluminios receives transfers (Nequi, Banco Caja Social…):
// the only list of them. Stable ids (never renamed); a new entity is a new row
// (added by a migration when the client asks; no screen yet). Inactive ones
// stay for history but are not offered.
model TransferEntity {
  id        String   @id
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  payments SalesOrderPayment[]
  refunds  SalesReturn[]

  @@map("transfer_entities")
}

// Return of delivered material (documento DV-000001), from one order.
// - Request: ADMIN or the owner seller, with lines (quantity per order line,
//   at most what was delivered and not yet returned), reason and settlement.
//   A seller's request waits for an administrator (task); an admin's is
//   approved at once.
// - Reception: warehouse staff of the place the material left from count
//   what came back (good / damaged). Good profiles go back to the bundles
//   they left (RETURN movements, same origin and lot); a closed bundle read
//   by its chip comes back closed. Damaged ones never enter the stock.
// - Money (at reception): `amount` is the value of what came back (with
//   tax; `baseAmount` without tax, for commissions). It first lowers what the
//   customer still owed; `settledAmount` is what they had paid beyond the new
//   net total: saldo a favor (CREDIT) or reintegro (REFUND, recorded later
//   with its medium).
// - Invoiced order: a task to billing for the credit note (nota crédito),
//   made in the billing software; its number is recorded here.
model SalesReturn {
  id                     String                @id @default(cuid())
  number                 String                @unique
  salesOrderId           String
  // The order's customer (its saldo a favor).
  customerId             String
  // Where it is received: the place the delivered material left from.
  inventoryLocationId    String
  status                 SalesReturnStatus
  reason                 SalesReturnReason
  notes                  String?
  settlement             SalesReturnSettlement
  createOperationKey     String                @unique
  requestedById          String
  // Administrator the seller asked (task); null when an admin requested it.
  approverId             String?
  decidedById            String?
  decidedAt              DateTime?             @db.Timestamptz(3)
  decisionNote           String?
  // Warehouse person with the reception task.
  receiverId             String?
  receivedById           String?
  receivedAt             DateTime?             @db.Timestamptz(3)
  receiveOperationKey    String?               @unique
  receptionNote          String?
  amount                 Decimal?              @db.Decimal(18, 2)
  baseAmount             Decimal?              @db.Decimal(18, 2)
  settledAmount          Decimal?              @db.Decimal(18, 2)
  refundMedium           PaymentMedium?
  refundTransferEntityId String?
  refundedOn             DateTime?             @db.Date
  refundNote             String?
  refundedAt             DateTime?             @db.Timestamptz(3)
  refundedById           String?
  creditNoteNumber       String?
  creditNoteAt           DateTime?             @db.Timestamptz(3)
  creditNoteById         String?
  cancelledAt            DateTime?             @db.Timestamptz(3)
  cancelledById          String?
  cancelReason           String?
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(3)

  salesOrder           SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer             Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  inventoryLocation    InventoryLocation @relation(fields: [inventoryLocationId], references: [id], onDelete: Restrict)
  requestedBy          User              @relation("ReturnRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approver             User?             @relation("ReturnApprover", fields: [approverId], references: [id], onDelete: Restrict)
  decidedBy            User?             @relation("ReturnDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  receiver             User?             @relation("ReturnReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  receivedBy           User?             @relation("ReturnReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  refundedBy           User?             @relation("ReturnRefundedBy", fields: [refundedById], references: [id], onDelete: Restrict)
  creditNoteBy         User?             @relation("ReturnCreditNoteBy", fields: [creditNoteById], references: [id], onDelete: Restrict)
  cancelledBy          User?             @relation("ReturnCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  refundTransferEntity TransferEntity?   @relation(fields: [refundTransferEntityId], references: [id], onDelete: Restrict)
  lines                SalesReturnLine[]
  tasks                Task[]

  @@index([salesOrderId])
  @@index([customerId, status])
  @@index([inventoryLocationId, status])
  @@index([status, createdAt])
  @@map("sales_returns")
}

// One order line in a return: requested profiles, and at reception the good
// and damaged ones with their value (proportional to the order line).
model SalesReturnLine {
  id               String  @id @default(cuid())
  salesReturnId    String
  salesOrderLineId String
  quantity         Int
  goodQuantity     Int?
  damagedQuantity  Int?
  amount           Decimal? @db.Decimal(18, 2)
  baseAmount       Decimal? @db.Decimal(18, 2)

  salesReturn    SalesReturn         @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  salesOrderLine SalesOrderLine      @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  movements      InventoryMovement[]

  @@unique([salesReturnId, salesOrderLineId])
  @@index([salesOrderLineId])
  @@map("sales_return_lines")
}

// What happened with an access attempt or a password.
enum LoginEventType {
  LOGIN_OK
  LOGIN_FAILED // wrong user or password (also unknown users)
  LOGIN_LOCKED // too many failures: refused without checking the password
  LOGIN_INACTIVE // right password, deactivated user
  PASSWORD_CHANGED // by the user
  PASSWORD_RESET // by an administrator (back to the ID number, must change it)
}

// Log of logins, failed attempts and password changes, for the administrator
// (Administración → Usuarios). `identifier` is what was typed as user (never
// the password); `userId` is set when it matched an account.
model LoginEvent {
  id         String         @id @default(cuid())
  type       LoginEventType
  identifier String
  userId     String?
  // Administrator who reset the password (PASSWORD_RESET).
  actorId    String?
  ip         String?
  userAgent  String?
  at         DateTime       @default(now()) @db.Timestamptz(3)

  // The log outlives a deleted user (it keeps what was typed); users are
  // normally deactivated, never deleted.
  user  User? @relation("LoginEventUser", fields: [userId], references: [id], onDelete: SetNull)
  actor User? @relation("LoginEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([userId, at])
  @@index([actorId])
  @@map("login_events")
}
