# Copia este archivo como .env y completa los valores reales localmente.
# Nunca subas .env al repositorio.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/solaluminios_dev?schema=public
PORT=3000
# Secreto aleatorio de al menos 32 caracteres (ver scripts/Configure-Jwt.mjs).
JWT_SECRET=
# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5173
# Web Push (opcional). Genera las tres con: node scripts/Configure-Vapid.mjs
# Sin ellas la API funciona y las notificaciones aparecen como no disponibles.
# La clave privada solo vive en el backend; nunca en VITE_* ni en el frontend.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
